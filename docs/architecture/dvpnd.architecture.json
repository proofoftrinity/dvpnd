  "cards": [
    {
      "dot": "cyan",
      "title": "One binary, one protocol",
      "items": [
        "[node] type picks WireGuard, AmneziaWG, OpenVPN, V2Ray, XRAY or Hysteria2",
        "The service owns the data plane: a kernel interface or a child process, NAT via iptables"
      ]
    },
    {
      "dot": "emerald",
      "title": "Handshake",
      "items": [
        "POST / is signed with the session account key; no prior tx needed",
        "HTTPS only, at most 30 attempts a minute per address",
        "The chain, not the node, says whether a session is active and paid"
      ]
    },
    {
      "dot": "amber",
      "title": "Chain",
      "items": [
        "lite/ is the only chain client: queries and signed txs over RPC",
        "Update intervals never exceed 80% of the chain status_timeout"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Clients pin the self-signed certificate; no CA involved",
        "Peers the database does not know are evicted every set_sessions tick",
        "Clients reach the internet only: not the host, private or link-local networks, or port 25",
        "Runs as root in a systemd sandbox, or with the four capabilities the Dockerfile keeps",
        "No client IPs or peer keys in the log unless run at debug"
      ]
    }
  ]
